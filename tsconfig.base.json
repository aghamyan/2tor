{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@app/db": ["packages/db/src/index.ts"],
      "@app/db/*": ["packages/db/src/*"],
      "@app/auth": ["packages/auth/src/index.ts"],
      "@app/auth/*": ["packages/auth/src/*"],
      "@app/audit": ["packages/audit/src/index.ts"],
      "@app/audit/*": ["packages/audit/src/*"],
      "@app/ui": ["packages/ui/src/index.ts"],
      "@app/ui/*": ["packages/ui/src/*"],
      "@app/config": ["packages/config/src/index.ts"],
      "@app/config/*": ["packages/config/src/*"],
      "@app/i18n": ["packages/i18n/src/index.ts"],
      "@app/i18n/*": ["packages/i18n/src/*"],
      "@app/validation": ["packages/validation/src/index.ts"],
      "@app/validation/*": ["packages/validation/src/*"],
      "@app/domain": ["packages/domain/src/index.ts"],
      "@app/domain/*": ["packages/domain/src/*"],
      "@app/email": ["packages/email/src/index.ts"],
      "@app/email/*": ["packages/email/src/*"],
      "@app/observability": ["packages/observability/src/index.ts"],
      "@app/observability/*": ["packages/observability/src/*"],
      "@app/notifications": ["packages/notifications/src/index.ts"],
      "@app/notifications/*": ["packages/notifications/src/*"],
      "@app/whatsapp": ["packages/whatsapp/src/index.ts"],
      "@app/whatsapp/*": ["packages/whatsapp/src/*"]
    }
  }
}
