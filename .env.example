# Copy to .env and adjust as needed. Every value here is a non-secret local/staging
# placeholder — never commit real credentials. See docs/INFRA.md for how each var is
# used and how to swap to managed AWS services (RDS / ElastiCache / S3) in production.

# --- Node / app runtime -----------------------------------------------------
NODE_ENV=development
WEB_PORT=3000

# --- Postgres (primary, service: postgres) ----------------------------------
# These match packages/db/drizzle.config.ts's built-in fallback, so
# `pnpm --filter db db:migrate` works from the host with no extra config once
# `docker compose up` has the container's 5432 mapped to localhost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
# Host-side convenience URL (containers build their own using the `postgres`
# service hostname instead of localhost — see docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- Postgres (test, docker-compose.test.yml, service: db_test) ------------
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=postgres
POSTGRES_TEST_DB=app_test
POSTGRES_TEST_PORT=5433
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/app_test

# --- Redis (service: redis) --------------------------------------------------
REDIS_PASSWORD=changeme-redis-password
REDIS_PORT=6379
# Host-side convenience URL; containers use the `redis` service hostname.
REDIS_URL=redis://:changeme-redis-password@localhost:6379

# --- MinIO / S3-compatible storage (services: minio, minio-init) -----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=app-uploads

# Generic S3 client config consumed by the app (works against MinIO locally,
# swap to real AWS values in staging/production — see docs/INFRA.md). Kept
# under an S3_ prefix rather than AWS_* so the SDK never silently picks up
# ambient AWS_* env vars / instance-profile credentials instead of these.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=changeme-minio-password
S3_FORCE_PATH_STYLE=true

# --- Caddy reverse proxy (service: caddy) -----------------------------------
HTTP_PORT=80
HTTPS_PORT=443
# "localhost" gets Caddy's local (self-signed) CA via `tls internal` in
# docker/Caddyfile. Set to a real domain in staging and see docs/INFRA.md for
# the one-line Caddyfile change that switches to Let's Encrypt.
SITE_ADDRESS=localhost
CADDY_EMAIL=admin@example.com

# --- Application integrations (set values in your untracked .env) ---------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
SENTRY_DSN=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
APP_URL=
SESSION_SECRET=
KMS_KEY_ID=
